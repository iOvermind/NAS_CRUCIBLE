#!/bin/bash
# =========================================================================
# Evidence Store：Live 環境下讓 Evidence 撐過重開機
#
# live rootfs 在 RAM，而一輪燒機要跑 3-5 天，中途斷電是預期內的事。因此開機時
# 在 Boot Medium 尾端的「未配置空間」建立兩個分區：
#   - ext4  CRUCIBLE_DATA -> /var/lib/crucible/logs    (完整 Evidence，需要 journaling)
#   - FAT32 CRUCIBLE_RPT  -> /var/lib/crucible/report  (人看的摘要，插到任何電腦都讀得到)
# 已經存在就直接掛載，不重建。
#
# 這是全系統唯一一個「非受測碟也會被寫入」的動作，所以：
#   1. 目標只能是 detect_boot_medium 反查到的那顆碟，反查不到就不動手；
#   2. 只用 sgdisk 在尾端新增分區，絕不觸碰任何既有分區；
#   3. 任何一步失敗一律降級為 No-Persistence Mode 繼續開機 —— Fail-Closed 該管的是
#      「要不要抹這顆碟」，不該在程式還沒開始前就把使用者擋在門外。見 docs/adr/0003。
# =========================================================================
set -u

CRUCIBLE_ROOT=${CRUCIBLE_ROOT:-/opt/nas_crucible}
DATA_LABEL=CRUCIBLE_DATA
RPT_LABEL=CRUCIBLE_RPT
DATA_MNT=${CRUCIBLE_DATA_MNT:-/var/lib/crucible/logs}
RPT_MNT=${CRUCIBLE_RPT_MNT:-/var/lib/crucible/report}
NOPERSIST_FLAG=${CRUCIBLE_NOPERSIST_FLAG:-/run/crucible/no-persistence}
FLAG_DIR=$(dirname "$NOPERSIST_FLAG")
RPT_SIZE_MB=256
MIN_FREE_MB=512

# shellcheck source=/dev/null
source "$CRUCIBLE_ROOT/lib/device_probe.sh"

log() { echo "[evidence-store] $*"; }

fallback_to_ram() {
    log "降級為 No-Persistence Mode：$1"
    mkdir -p "$DATA_MNT" "$RPT_MNT" "$FLAG_DIR"
    mountpoint -q "$DATA_MNT" || mount -t tmpfs -o size=256m tmpfs "$DATA_MNT"
    printf '%s\n' "$1" > "$NOPERSIST_FLAG"
    exit 0
}

mount_by_label() { # mount_by_label <label> <mountpoint>
    local dev
    dev=$(blkid -L "$1" 2>/dev/null) || return 1
    [ -n "$dev" ] || return 1
    mount "$dev" "$2" 2>/dev/null
}

mkdir -p "$FLAG_DIR" "$DATA_MNT" "$RPT_MNT"
rm -f "$NOPERSIST_FLAG"

# --- 1. 已經存在就直接掛載 ---
if mount_by_label "$DATA_LABEL" "$DATA_MNT"; then
    log "掛載既有的 Evidence Store 成功"
    mount_by_label "$RPT_LABEL" "$RPT_MNT" \
        || log "摘要分區不存在或掛載失敗 (不影響 Evidence 保存)"
    exit 0
fi

# --- 2. 反查 Boot Medium。反查不到就絕不動手 ---
boot_dev=$(detect_boot_medium) \
    || fallback_to_ram "反查不到開機媒體，不對任何裝置寫入分區表"
disk="/dev/$boot_dev"
[ -b "$disk" ] || fallback_to_ram "開機媒體 $disk 不是區塊裝置"

for cmd in sfdisk mkfs.ext4 mkfs.vfat partx blkid blockdev; do
    command -v "$cmd" >/dev/null 2>&1 || fallback_to_ram "缺少必要指令 $cmd"
done

# --- 3. 尾端剩餘空間是否夠用 ---
# 不用 gdisk/sgdisk：isohybrid 映像的 MBR 第一個分割區型別是 0x00，gdisk 判定為
# 「Invalid partition data!」而完全讀不進來 (QEMU 端到端測試實測)。核心對這種
# 映像認的本來就是 MBR (fdisk 顯示 Disklabel type: dos)，因此直接用 sfdisk
# 在尾端「追加」分割區 —— 既有的分割區完全不會被改寫。
table=$(sfdisk -d "$disk" 2>/dev/null) || fallback_to_ram "讀不到 $disk 的分割表"
label=$(printf '%s\n' "$table" | awk -F': *' '/^label:/{print $2; exit}')
used=$(printf '%s\n' "$table" | grep -c 'start=')

# MBR 只有四個 primary slot。放不下兩個新分區就不要動手。
if [ "$label" != gpt ] && [ "$used" -gt 2 ]; then
    fallback_to_ram "MBR 分割區已用掉 $used 個，容不下 Evidence Store"
fi

ss=$(blockdev --getss "$disk" 2>/dev/null) || ss=512
bytes=$(blockdev --getsize64 "$disk" 2>/dev/null) || fallback_to_ram "讀不到 $disk 的容量"
total=$(( bytes / ss ))
last=$(printf '%s\n' "$table" | awk -F'[=,]' '/start=/{s=$2+0; z=$4+0; if (s+z>m) m=s+z} END{print m+0}')
align=$(( 1048576 / ss ))
start=$(( (last + align - 1) / align * align ))
[ "$total" -gt "$start" ] || fallback_to_ram "開機媒體尾端沒有剩餘空間"
free_mb=$(( (total - start) * ss / 1048576 ))
log "$disk 尾端剩餘 ${free_mb}MB"
[ "$free_mb" -ge "$MIN_FREE_MB" ] \
    || fallback_to_ram "開機媒體剩餘空間只有 ${free_mb}MB，不足 ${MIN_FREE_MB}MB"

# --- 4. 只在尾端追加兩個分區 ---
if [ "$label" = gpt ]; then
    rpt_type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7   # Microsoft basic data
    data_type=0FC63DAF-8483-4772-8E79-3D69D8477DE4  # Linux filesystem
else
    rpt_type=c    # W95 FAT32 (LBA)
    data_type=83  # Linux
fi
rpt_sectors=$(( RPT_SIZE_MB * 1048576 / ss ))

printf 'start=%s, size=%s, type=%s\nstart=%s, type=%s\n' \
    "$start" "$rpt_sectors" "$rpt_type" "$(( start + rpt_sectors ))" "$data_type" \
  | sfdisk --append --no-reread "$disk" >/dev/null 2>&1 \
  || fallback_to_ram "在 $disk 尾端追加分割區失敗"

# 開機媒體的 ISO 分區正掛載中，整表 re-read 會 EBUSY；partx -a 走 BLKPG，
# 只把新分區加進核心，不動既有的 (對既存分區回報忙碌是預期的，忽略)。
partx -a "$disk" >/dev/null 2>&1
command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=10 >/dev/null 2>&1

new_table=$(sfdisk -d "$disk" 2>/dev/null)
rpt_part=$(printf '%s\n' "$new_table" | awk '/start=/{print $1}' | tail -2 | head -1)
data_part=$(printf '%s\n' "$new_table" | awk '/start=/{print $1}' | tail -1)
[ -b "${data_part:-}" ] || fallback_to_ram "新建的 Evidence 分區沒有出現在核心中"

# --- 5. 建檔案系統並掛載 ---
mkfs.ext4 -q -F -L "$DATA_LABEL" "$data_part" >/dev/null 2>&1 \
    || fallback_to_ram "格式化 Evidence 分區失敗"
mount "$data_part" "$DATA_MNT" \
    || fallback_to_ram "掛載 Evidence 分區失敗"

if [ -b "${rpt_part:-}" ]; then
    if mkfs.vfat -n "$RPT_LABEL" "$rpt_part" >/dev/null 2>&1; then
        mount "$rpt_part" "$RPT_MNT" || log "摘要分區掛載失敗 (不影響 Evidence 保存)"
    else
        log "摘要分區格式化失敗 (不影響 Evidence 保存)"
    fi
fi

log "Evidence Store 就緒：$data_part -> $DATA_MNT"
exit 0
